---
# Образец. Реальный файл создаётся так (см. README):
#   cp vault.yml.example vault.yml && ansible-vault encrypt vault.yml
# Значения генерируйте:  openssl rand -hex 32
vault_db_admin_password: "CHANGE_ME"
vault_db_app_password: "CHANGE_ME"
vault_app_jwt_secret: "CHANGE_ME"
# Нужен, только если sudo на ВМ запрашивает пароль:
# ansible_become_password: "CHANGE_ME"
