# Управляется Ansible (роль app). Ручные правки будут перезаписаны.
name: {{ app_compose_project }}

services:
  app:
    image: {{ app_image_name }}:{{ app_image_tag }}
    build:
      context: ./src
      dockerfile: Dockerfile
    env_file:
      - .env
    ports:
      - "{{ app_bind_ip }}:{{ app_port }}:8080"
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "--show-error", "http://127.0.0.1:8080/health"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 30s
    init: true
    stop_grace_period: 20s
    restart: unless-stopped
    mem_limit: {{ app_mem_limit }}
    cpus: {{ app_cpus }}
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp:size=32m,mode=1777
